{
  "_комментарий": "A/B для Gemma-4-26B-A4B (b11382, --reasoning off): RP-текст со спекуляцией vs без. Плюс код как контроль.",
  "server": "${PROJECT_DIR}/downloads/llama-b11382-cu124/llama-server.exe",
  "model": "${MODELS_DIR}/mradermacher/Gemma-4-26B-A4B-StyleTune-V2-GGUF/Gemma-4-26B-A4B-StyleTune-V2.IQ4_XS.gguf",
  "common": [
    "--alias", "Gemma-4-26B-A4B-test",
    "--fit", "on", "-fa", "on", "--load-mode", "none",
    "-t", "14", "-tb", "14", "-b", "2048", "-ub", "512",
    "-np", "1", "-c", "65536",
    "-ctk", "q4_0", "-ctv", "q4_0",
